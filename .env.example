# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "mysql" (normal) or "sqlite" (quick local runs without MySQL).
# Tests always use SQLite, whatever this says.
DB_ENGINE=mysql
DB_NAME=ict712_auction
DB_USER=auction_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# True = run background tasks immediately, without Redis or a worker.
CELERY_TASK_ALWAYS_EAGER=False

# Email (console backend prints emails in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@southerncrossauctions.local
# Start of the links in emails
SITE_URL=http://127.0.0.1:8000

# Payments: False = mocked "Pay now" step
USE_STRIPE=False
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
